{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "investment-hub",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-29",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "run_worker_first": [
      "/api/*"
    ],
    "binding": "ASSETS"
  },
  "vars": {
    "OKX_API_BASE": "https://openapi.okx.com"
  }
}